# Copy this file to .env and fill in real values. .env is git-ignored -- never commit it.

# Postgres connection string. When running via `docker compose up`, the host is the
# service name `db`, not `localhost` (containers reach each other by service name).
DATABASE_URL=postgres://postgres:dev@db:5432/widget_platform

# Any long random string -- used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-real-random-secret

# The base URL this API is reachable at -- used to build each widget's embed snippet.
PUBLIC_BASE_URL=http://localhost:8000

# Geo provider toggles -- used to run PROBE 4 (the fallback-chain acceptance test) live:
# set one or both to "true", then `docker compose restart api`, to prove the fallback
# and the "all down" degrade-not-fail path against the real running system.
GEO_PROVIDER_A_DISABLED=false
GEO_PROVIDER_B_DISABLED=false
